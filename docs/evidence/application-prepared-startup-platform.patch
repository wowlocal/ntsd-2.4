+    }
+
+    /// Reference requests/stores/observations are checked independently. Only
+    /// native replies feed Core. No audit after-state initializes the platform.
+    final class Audit: OriginalApplicationWindowStartupPlatform {
+        let native: N, audit: P.Adapter
+        var failCopies = false
+        init(_ native: N,_ audit: P.Adapter) { self.native = native; self.audit = audit }
+        func stagedCopy() throws -> Audit {
+            if failCopies { throw P.Trial.late }
+            return try .init(native.stagedCopy(),audit.stagedCopy())
+        }
+        var windowExchange: E.Cursor? {
+            get { native.windowExchange }
+            set { native.windowExchange = newValue }
+        }
+        var panelIO: OriginalWinMainStartup.PanelIO { native.panelIO }
+        var environmentTZ: [UInt8]? { native.environmentTZ }
+        var sound: OriginalMenuSoundStartup.Platform { native.sound }
+        func milliseconds() throws -> UInt32 { let r = try native.milliseconds(); XCTAssertEqual(r,try audit.milliseconds()); return r }
+        func initializeCriticalSection(_ a: UInt32) throws -> [UInt8] { let r = try native.initializeCriticalSection(a); XCTAssertEqual(r,try audit.initializeCriticalSection(a)); return r }
+        func initializeCOM() throws -> UInt32 { let r = try native.initializeCOM(); XCTAssertEqual(r,try audit.initializeCOM()); return r }
+        func window(_ q: OriginalWindowInitialization.Request) throws -> E.Response {
+            let r = try native.window(q); try OriginalApplicationPreparedStartupPlatformTests.same(r,audit.window(q)); return r
+        }
+        func file(_ path: String) throws -> [UInt8]? { let r = try native.file(path); XCTAssertEqual(r,try audit.file(path)); return r }
+        func writePanel(_ bytes: [UInt8]) throws -> Int32 { let r = try native.writePanel(bytes); XCTAssertEqual(r,try audit.writePanel(bytes)); return r }
+        func closePanel() throws -> Int32 { let r = try native.closePanel(); XCTAssertEqual(r,try audit.closePanel()); return r }
+        func allocatePanel() throws -> OriginalInterfaceAllocation {
+            let r = try native.allocatePanel(),e = try audit.allocatePanel(); XCTAssertEqual(r.address,e.address); XCTAssertEqual(r.backing,e.backing); return r
+        }
+        func panelBitmap(_ path: String) throws -> OriginalBitmapInput { let r = try native.panelBitmap(path); XCTAssertEqual(r,try audit.panelBitmap(path)); return r }
+        func panelDevice() throws -> (surface: UInt32,colorKeyResult: Int32) {
+            let r = try native.panelDevice(),e = try audit.panelDevice(); XCTAssertEqual(r.surface,e.surface); XCTAssertEqual(r.colorKeyResult,e.colorKeyResult); return r
+        }
+        func filetime() throws -> UInt64 { let r = try native.filetime(); XCTAssertEqual(r,try audit.filetime()); return r }
+        func timezone() throws -> (result: UInt32,zone: OriginalCalendarTime.Zone?) {
+            let r = try native.timezone(),e = try audit.timezone(); XCTAssertEqual(r.result,e.result)
+            try OriginalApplicationPreparedStartupPlatformTests.same(r.zone,e.zone); return r
+        }
+        func allocateCalendar(_ count: Int) throws -> OriginalInterfaceAllocation {
+            let r = try native.allocateCalendar(count),e = try audit.allocateCalendar(count); XCTAssertEqual(r.address,e.address); XCTAssertEqual(r.backing,e.backing); return r
+        }
+        func convertZoneName(_ name: String,_ count: Int) throws -> [UInt8] { let r = try native.convertZoneName(name,count); XCTAssertEqual(r,try audit.convertZoneName(name,count)); return r }
+        func music(_ q: OriginalMusicEvent) throws -> OriginalMusicResponse {
+            let r = try native.music(q),e = try audit.music(q)

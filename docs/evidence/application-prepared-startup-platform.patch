+        }
+        func cursor(_ load: Bool,_ args: [UInt32]) throws -> UInt32 { let r = try native.cursor(load,args); XCTAssertEqual(r,try audit.cursor(load,args)); return r }
+        func joystick(_ q: OriginalInputStartup.Request,_ g: OriginalStateRecord) throws -> OriginalInputStartup.Response {

+    /// Only declared spec/API input values are projected. The "backing" member
+    /// is recorded before allocation; never use its later "bytes"/"mask" result.
+    func preparation(_ p: P.Adapter) throws -> N.Prepared {
+        let c = p.c
+        var result = N.Prepared(panelIO:p.panelIO,environmentTZ:p.environmentTZ,sound:p.sound)
+        result.files["data\\adinfo.txt"] = c.spec.panel.info.map(N.File.bytes) ?? .absent
+        var names = 0
+        for (event,raw) in zip(c.events,p.rawEvents) {
+            switch event.kind {
+            case "timeGetTime":result.milliseconds.append(c.spec.milliseconds)
+            case "initializeCriticalSection":
+                result.criticalSections.append(.init(try XCTUnwrap(event.arguments?.first),c.spec.criticalSection))
+            case "coInitialize":result.com.append(try XCTUnwrap(event.result))
+            case "filetime":result.filetimes.append(c.spec.filetime)
+            case "timezone":result.zones.append(.init(c.spec.zoneResult ?? 0,c.spec.zone))
+            case "allocate":
+                let address = try XCTUnwrap(event.address),count = try XCTUnwrap(event.count)
+                let backing = try address == 0 ? [] : p.blob(XCTUnwrap(c.after.allocations.first { $0.address == address }?.backing))
+                result.calendarAllocations.append(.init(count,.init(address:address,backing:backing)))
+            case "nameConversion":
+                let name = names == 0 ? c.spec.zone.standardName : c.spec.zone.daylightName; names += 1
+                result.zoneNames.append(.init(.init(name,try XCTUnwrap(event.capacity)),try XCTUnwrap(event.bytes)))
+            case "music":
+                let m = try XCTUnwrap(event.music)
+                if m.kind != .helper && m.kind != .format { result.music.append(.init(.init(m.kind,m.arguments,m.strings),m.response)) }
+            case "loadCursor","setCursor":
+                result.cursors.append(.init(.init(event.kind == "loadCursor",try XCTUnwrap(event.arguments)),try XCTUnwrap(event.result)))
+            case "panel-content","panel-defaults":
+                let e = try JSONDecoder().decode(P.PanelEvent.self,from:JSONSerialization.data(withJSONObject:XCTUnwrap(raw["event"])))
+                if event.kind == "panel-content" && e.kind == "open" {
+                    let path = String(decoding:try XCTUnwrap(e.strings?.first),as:UTF8.self)
+                    result.files[path] = c.spec.panel.content.map(N.File.bytes) ?? .absent
+                }
+                if e.kind == "writeFile" { result.panelWrites.append(.init(try XCTUnwrap(e.strings?.first),Int32(bitPattern:try XCTUnwrap(e.result)))) }
+                if e.kind == "closeFile" { result.panelCloses.append(Int32(bitPattern:try XCTUnwrap(e.result))) }
+            default:break
+            }
+        }
+        for child in c.panel.children where child.kind == "bitmap" {
+            if let a = child.allocation { result.panelAllocations.append(try .init(address:a.address,backing:a.backing.map(p.blob) ?? [])) }
+            if let bitmap = child.resource { result.panelBitmaps.append(.init(bitmap.path,bitmap)) }
+            if child.allocation?.address != 0,let surface = child.surface,let code = child.colorKeyResult { result.panelDevices.append(.init(surface,code)) }
+        }
+        for j in c.input?.joyRequests ?? [] { result.joysticks.append(.init(j.request,j.response)) }
+        for (i,w) in (c.input?.loads ?? []).enumerated() {
+            let path = String(decoding:w.path,as:UTF8.self)
+            result.waves.append(.init(.init(i,path,w.input.destination,w.input.device),w.input))
+        }
+        return result
+    }
+    func audited(_ p: P.Adapter,_ package: OriginalApplicationStartupInputs,
+                 retaining resources: [any OriginalApplicationStartupResource] = []) throws -> Audit {
+        var prepared = try preparation(p); prepared.resources = resources
+        // WAV bytes use the real input package, checked against immutable source
+        // input hashes. These are not decoded expected PCM or output storage.
+        for w in p.c.input?.loads ?? [] {
+            let path = String(decoding:w.path,as:UTF8.self)

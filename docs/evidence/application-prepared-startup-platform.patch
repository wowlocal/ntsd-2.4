+    @discardableResult
+    func drive(_ driver: Driver,_ p: P.Adapter,prepare: (Audit) throws -> Void = { _ in },
+        before: (OriginalWinMainStartup,Host.Session,Audit) throws -> Void = { _,_,_ in },
+        failed: (Audit,Error) -> Void = { _,_ in }) throws -> Host {

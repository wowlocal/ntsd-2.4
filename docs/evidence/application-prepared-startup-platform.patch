+        let actual = N(inputs:package,prepared:values)
+        values.milliseconds = [99]; values.files["empty"] = .bytes([1])
+        XCTAssertThrowsError(try actual.validatePreparedConsumption()) { XCTAssertEqual($0 as? N.Boundary,.unconsumed(.milliseconds,1)) }
+        for (_,call) in calls { try call(actual) }
+        try actual.validatePreparedConsumption()
+        XCTAssertEqual(actual.snapshot.panelWrites,[[8,9]]); XCTAssertEqual(actual.snapshot.panelCloses,[-5])
+        XCTAssertNil(try actual.file("absent")); XCTAssertEqual(try actual.file("empty"),[])
+        XCTAssertNil(try actual.file("data\\ad0.txt")); XCTAssertEqual(try actual.file("data\\m_join.wav"),try package.file("data\\m_join.wav"))
+        XCTAssertThrowsError(try actual.file("unsupported"))
+        let saved = actual.snapshot
+        XCTAssertThrowsError(try actual.window(.init("metric",[1]))) { XCTAssertEqual($0 as? N.Boundary,.missingWindowCursor) }
+        XCTAssertEqual(actual.snapshot,saved)
+        _ = try actual.music(.init(.helper,[0x402020])); _ = try actual.music(.init(.format,[],[]))
+        XCTAssertEqual(actual.snapshot,saved); try actual.validatePreparedConsumption()
+    }

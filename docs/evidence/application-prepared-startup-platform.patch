+    func testLateFailuresCopiesAndRetainedOwners() throws {
+        let package = try OriginalApplicationStartupInputsTests.shared.get()
+        for phase in ["window-return","panel-return","secondDate","output-return","fifthWave","after","publication-copy"] {
+            let (p,initial) = try D().inputs()
+            let original = try audited(p,package)
+            let driver = try Driver(platform:original,instance:0x400000,show:10,initial:initial)
+            var reached = 0
+            XCTAssertThrowsError(try drive(driver,p,prepare:{ $0.audit.fail = phase },before:{ owner,session,candidate in
+                try candidate.audit.complete(owner,self.globals(session)); try candidate.native.validatePreparedConsumption()
+                if phase == "after" { throw P.Trial.late }
+                if phase == "publication-copy" { candidate.failCopies = true }
+            },failed:{ candidate,error in
+                if error is P.Trial {
+                    reached += 1
+                    XCTAssertGreaterThan(candidate.native.snapshot.positions[.milliseconds,default:0],0)
+                }
+            })) { XCTAssertTrue($0 is P.Trial) }
+            XCTAssertEqual(reached,1); try unchanged(driver,p)
+            XCTAssertEqual(original.native.snapshot,N.Snapshot()); XCTAssertEqual(p.index,0)
+            let receipts = driver.exchangeSnapshot.receipts
+            let host = try drive(driver,p,before:{ owner,session,candidate in
+                try candidate.audit.complete(owner,self.globals(session)); try candidate.native.validatePreparedConsumption()
+            })
+            XCTAssertEqual(driver.exchangeSnapshot.receipts.map(\.request),receipts.map(\.request))
+            XCTAssertEqual(driver.exchangeSnapshot.receipts.map(\.response),receipts.map(\.response))
+            let committed = try host.platformSnapshot(),copy = try committed.native.stagedCopy()
+            XCTAssertFalse(copy === committed.native); XCTAssertEqual(copy.snapshot,committed.native.snapshot)
+            XCTAssertEqual(copy.snapshot.panelWrites,committed.native.snapshot.panelWrites)
+            try copy.validatePreparedConsumption()
+            XCTAssertEqual(try host.takeCommitted()?.sequence,1); XCTAssertNil(try host.takeCommitted())
+        }
+        do {
+            let (p,initial) = try D().inputs()
+            let original = try audited(p,package)
+            let driver = try Driver(platform:original,instance:0x400000,show:10,initial:initial)
+            XCTAssertThrowsError(try driver.resume(prepare:{ candidate in
+                _ = try candidate.native.milliseconds(); throw P.Trial.late
+            })) { XCTAssertTrue($0 is P.Trial) }
+            try unchanged(driver,p); XCTAssertTrue(driver.exchangeSnapshot.receipts.isEmpty)
+            XCTAssertEqual(original.native.snapshot,N.Snapshot())
+            _ = try drive(driver,p,before:{ owner,session,candidate in
+                try candidate.audit.complete(owner,self.globals(session)); try candidate.native.validatePreparedConsumption()
+            })
+        }
+        let (p,initial) = try D().inputs()
+        weak var weakOwner: Resource?
+        func make() throws -> Driver {
+            let owner = Resource(); weakOwner = owner
+            return try Driver(platform:audited(p,package,retaining:[owner]),instance:0x400000,show:10,initial:initial)
+        }
+        var driver: Driver? = try make()
+        var host: Host? = try drive(XCTUnwrap(driver),p,before:{ owner,session,candidate in
+            try candidate.audit.complete(owner,self.globals(session)); try candidate.native.validatePreparedConsumption()
+        })
+        var batch = try XCTUnwrap(host).takeCommitted()
+        XCTAssertNotNil(weakOwner); driver = nil; host = nil; XCTAssertNotNil(weakOwner)
+        let retained = try XCTUnwrap(batch).context
+        XCTAssertEqual(try retained.platformSnapshot().native.snapshot.positions[.milliseconds],1)
+        batch = nil
+        // The explicitly retained context is still a lifetime owner.
+        XCTAssertNotNil(weakOwner)
+        try assertRelease(p,package,initial)
+    }
+    func assertRelease(_ p: P.Adapter,_ package: OriginalApplicationStartupInputs,_ initial: OriginalStateRecord) throws {
+        weak var weakOwner: Resource?
+        func run() throws {
+            let owner = Resource(); weakOwner = owner
+            let driver = try Driver(platform:audited(p,package,retaining:[owner]),instance:0x400000,show:10,initial:initial)
+            let host = try drive(driver,p)
+            var batch = try host.takeCommitted()
+            XCTAssertNotNil(weakOwner); batch = nil
+        }
+        try run(); XCTAssertNil(weakOwner)
+    }

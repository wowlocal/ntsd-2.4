+    enum Stop: Error { case missingOutcome }
+    final class Resource: OriginalApplicationStartupResource {}
+    static func same<T: Encodable>(_ a: T,_ b: T) throws {
+        let e = JSONEncoder(); e.outputFormatting = [.sortedKeys]
